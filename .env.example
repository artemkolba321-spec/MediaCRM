# MediaCRM — Supabase Configuration
#
# 1. Скопируйте этот файл в .env:
#      cp .env.example .env
#
# 2. Заполните значения из панели Supabase:
#      Project Settings → API → Project URL
#      Project Settings → API → anon public key
#
# 3. Не коммите .env в Git — он исключён в .gitignore.

SUPABASE_URL=
SUPABASE_ANON_KEY=
